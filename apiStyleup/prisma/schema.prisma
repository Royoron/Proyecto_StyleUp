// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
}

model Cliente {
  cedula_cliente String   @id
  nombre         String
  apellido       String
  telefono       String
  correo         String   @unique
  contrasena     String
  fecha_registro DateTime @default(now())

  // Relaciones
  citas          Cita[]
  historial      HistorialCita[]

  @@map("clientes")
}

model Barbero {
  cedula_barbero  String   @id
  nombre          String
  apellido        String
  id_especialidad Int
  correo          String   @unique
  contrasena      String
  telefono        String
  fecha_registro  DateTime @default(now())

  // Relaciones
  especialidad    Especialidad @relation(fields: [id_especialidad], references: [id_especialidad])
  citas           Cita[]
  horarios        HorarioBarbero[]

  @@index([id_especialidad])
  @@map("barberos")
}

model Especialidad {
  id_especialidad Int    @id @default(autoincrement())
  especialidad    String
  tiempo_estimado Int    // En minutos

  // Relaciones
  barberos        Barbero[]
  citas           Cita[]

  @@unique([especialidad])
  @@map("especialidades")
}

model Cita {
  id_cita         String   @id @default(cuid())
  cedula_cliente  String
  cedula_barbero  String
  id_especialidad Int
  fecha           DateTime
  hora            String   // Formato HH:MM
  estado          String   @default("Pendiente")

  // Relaciones
  cliente         Cliente       @relation(fields: [cedula_cliente], references: [cedula_cliente])
  barbero         Barbero       @relation(fields: [cedula_barbero], references: [cedula_barbero])
  especialidad    Especialidad  @relation(fields: [id_especialidad], references: [id_especialidad])
  historial       HistorialCita[]

  @@index([fecha])
  @@index([cedula_barbero, fecha])
  @@index([estado])
  @@map("citas")
}

model HistorialCita {
  id_historial   Int      @id @default(autoincrement())
  cedula_cliente String
  id_cita        String
  fecha          DateTime @default(now())

  // Relaciones
  cliente        Cliente @relation(fields: [cedula_cliente], references: [cedula_cliente])
  cita           Cita    @relation(fields: [id_cita], references: [id_cita])

  @@index([cedula_cliente, fecha])
  @@map("historial_citas")
}

model EstadoBarbero {
  id_estado Int    @id @default(autoincrement())
  estado    String @unique // Disponible, Ocupado, Descanso

  // Relaciones
  horarios  HorarioBarbero[]

  @@map("estados_barbero")
}

model HorarioBarbero {
  id_horario     Int      @id @default(autoincrement())
  cedula_barbero String
  id_estado      Int
  hora_inicio    String
  hora_fin       String
  fecha          DateTime

  // Relaciones
  barbero        Barbero       @relation(fields: [cedula_barbero], references: [cedula_barbero])
  estado         EstadoBarbero @relation(fields: [id_estado], references: [id_estado])

  @@index([cedula_barbero, fecha])
  @@map("horarios_barbero")
}

model SuperAdmin {
  id         String   @id @default(cuid())
  correo     String   @unique
  contrasena String
  activo     Boolean  @default(true)
  creado_en  DateTime @default(now())

  @@map("superadmin")
}

enum RefreshTokenSubjectType {
  CLIENTE
  BARBERO
  SUPERADMIN
}

model RefreshToken {
  id          String                  @id @default(cuid())
  token_hash  String                  @unique
  subjectType RefreshTokenSubjectType
  subjectId   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime                @default(now())

  @@index([subjectType, subjectId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}